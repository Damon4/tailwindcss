  "scripts": {
    "lint": "tsc --noEmit",
    "dev": "rspack serve --config ./rspack.config.js --mode=development",
    "build": "rspack build --config ./rspack.config.js --mode=production"
  },
  "imports": {
    "#config.css": "./src/styles/config.css"
  },
  "dependencies": {
    "@tailwindcss/postcss": "workspace:^",
